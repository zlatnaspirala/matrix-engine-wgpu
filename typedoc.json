{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["index.js"],
  "out": "api-docs",
  "name": "Matrix Engine Api Documentation",
  "includeVersion": true,
  "searchInComments": true,

  "intentionallyNotExported": [
    "BVHPlayer", "BVHPlayerInstances", "__function", "GLBModel",
    "VolumetricPass", "TextureCache", "AdvancedVolumetricPass",
    "SSRPass", "PhysicsBridge", "MatrixSounds", "MultiLang",
    "IndirectRenderingManager", "GPUCapabilities", "CulledRenderPass",
    "ComputeCullingSystem", "BloomPass", "AudioAssetManager",
    "default", "Editor"],

  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "module": "ESNext",
    "target": "ESNext",
    "lib": ["DOM", "ESNext"],
    "moduleResolution": "node"
  }
}
