{
  "name": "matrix-engine-wgpu",
  "version": "2.0.0",
  "description": "2.0.0 beta : migration to esbuild to avoid security bugs with old compile system, effects sunrender system updated every type of effect have own pipeline cache manager this is powerfull for effects mass reuse, GPU culling vs Indirect draws - push it to the limits. AI Code Creator (use engine from npm direct render preview)Cast received for android TV, splat point clouds + color animator and vertex shader animation",
  "main": "index.js",
  "scripts": {
    "examples": "esbuild examples.js --bundle --outfile=public/examples.js --format=esm --watch",
    "build:examples": "esbuild examples.js --bundle --minify --sourcemap --drop:console --target=es2022 --format=esm --outfile=public/examples.min.js",
    "android-tv-cast": "esbuild android-tv-cast.js --bundle --outfile=public/android-tv-cast.js --format=esm --watch",
    "jamb": "esbuild ./examples/games/jamb/jamb.js --bundle --outfile=public/yacht.js --format=esm --watch",
    "demo1": "esbuild demo1.js --bundle --outfile=public/app.js --format=esm --watch",
    "empty": "esbuild empty.js --bundle --outfile=public/empty.js --format=esm --watch",
    "build.jamb": "esbuild main.js --bundle --outfile=public/app.js --format=esm",
    "glb-loader": "esbuild ./examples/glb-loader.js --bundle --outfile=public/app.js --format=esm --watch",
    "moba": "esbuild ./examples/games/moba/forestOfHollowBlood.js --bundle --outfile=public/moba-game.js --format=esm --watch",
    "moba-menu": "esbuild ./examples/games/moba/start-menu.js --bundle --outfile=public/moba-menu.js --format=esm --watch",
    "build-all": "npm run examples | npm run main | npm run empty",
    "creator-install": "npm --prefix src/tools/the-beast-code-gen i",
    "creator": "npm --prefix src/tools/the-beast-code-gen run dev",
    "creator-backend": "npm --prefix src/tools/the-beast-code-gen run backend",
    "landpage": "esbuild ./examples/my-lights.js --bundle --outfile=public/landpage.js --format=esm --watch",
    "hosts": "http-server ./public/ -p 3000",
    "editor-landing": "esbuild ./src/tools/editor/template/autogen.js --bundle --outfile=public/matrix-engine-autogen.js --format=esm --watch",
    "editorx": "cd src/tools/editor/backend && node matrix-editor.js",
    "webp-to-dds": "npm run webp-to-dds0 && npm run webp-to-dds1",
    "webp-to-dds0": "cd public/res/textures/ && for %f in (*.webp) do magick \"%f\" \"%~nf.dds\"",
    "webp-to-dds1": "cd public/res/textures/env-maps/ && for %f in (*.webp) do magick \"%f\" \"%~nf.dds\""
  },
  "author": "Nikola Lukic",
  "license": "MIT",
  "devDependencies": {
    "browser-resolve": "^2.0.0",
    "esbuild": "^0.27.1",
    "http-server": "^14.1.1",
    "msdf-bmfont-xml": "^2.8.0",
    "ollama": "^0.6.3",
    "typedoc": "^0.28.16",
    "wgpu-matrix": "^2.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@google/generative-ai": "^0.24.1",
    "@mediapipe/face_mesh": "^0.4.1633559619",
    "@mediapipe/pose": "^0.5.1675469404",
    "@mediapipe/tasks-vision": "^0.10.35",
    "bvh-loader": "1.1.0",
    "gl-matrix": "^3.4.4",
    "groq-sdk": "^0.37.0",
    "nui-commander": "^1.2.0"
  },
  "peerDependencies": {
    "wgpu-matrix": "^2.0.0"
  },
